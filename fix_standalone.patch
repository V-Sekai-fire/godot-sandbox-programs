# Patch for godot-sandbox CMakeLists.txt to support standalone builds
# Fixes the unconditional RISCV_ABI flag that breaks host compiler builds

--- a/build/_deps/godot-sandbox-src/program/cpp/cmake/CMakeLists.txt
+++ b/build/_deps/godot-sandbox-src/program/cpp/cmake/CMakeLists.txt
@@ -52,8 +52,6 @@ if ("${CMAKE_CXX_COMPILER}" MATCHES "riscv64-unknown-elf*")
 endif()
 
 # If the compiler contains Zig, don't set RISCV_ARCH and RISCV_ABI
-if (${CMAKE_CXX_COMPILER} MATCHES "zig")
-	set(RISCV_ABI "-mabi=lp64d")
 else()
 	if (SANDBOX_RISCV_EXT_C)
 		set(RISCV_ARCH "-march=rv64gc_zba_zbb_zbs_zbc")
@@ -67,7 +65,9 @@ else()
 		set(RISCV_ARCH "-march=rv64g_zba_zbb_zbs_zbc")
 	endif()
+	# Only set RISC-V ABI flags when actually compiling with RISC-V compiler
+	if (EMBEDDED_RISCV)
 set(RISCV_ABI "-mabi=lp64d")
+endif()
 endif()
 
 if (FLTO)
@@ -116,8 +116,9 @@ if (DOWNLOAD_RUNTIME_API)
 
 target_compile_options(sandbox_api PUBLIC
 	${RISCV_ARCH} ${RISCV_ABI}
+	# RISC-V flags only make sense with RISC-V compiler, not host compiler
+	$<$<AND:$<COMPILE_LANGUAGE:CXX>,$<BOOL:${EMBEDDED_RISCV}>>:${CXXFLAGS}>
 	$<$<COMPILE_LANGUAGE:CXX>:${CXXFLAGS}>
-	$<$<COMPILE_LANGUAGE:CXX>:${CXXFLAGS}>
 target_include_directories(sandbox_api PRIVATE
 	${CMAKE_CURRENT_SOURCE_DIR}
 	${CMAKE_CURRENT_SOURCE_DIR}/include
